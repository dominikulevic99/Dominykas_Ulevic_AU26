/*
 The direct JOIN solution is the most suitable for this task because the
 relationships and aggregation are simple and easy to understand.
 
 A CTE would improve readability if the actor movie counts were reused in
 several later steps. A subquery could also calculate the counts, but it would
 add nesting without providing a clear advantage here.
 
 All three approaches are possible because they can produce the same grouped
 result. They are included only because the assignment requires JOIN, CTE and
 subquery versions.
 */
-- update for thid problem the faster desicion is FETCH FIRST 5 ROWS WITH TIES this will prevents LIMIT problem when we have dublicates number of films
SELECT a.first_name,
    a.last_name,
    COUNT(f.film_id) AS number_of_movies
FROM public.actor AS a
    INNER JOIN public.film_actor AS fa ON fa.actor_id = a.actor_id
    INNER JOIN public.film AS f ON f.film_id = fa.film_id
WHERE f.release_year >= 2015
GROUP BY a.actor_id,
    -- we use a.actor_id because names could have duplicates
    a.first_name,
    a.last_name
ORDER BY COUNT(DISTINCT f.film_id) DESC
FETCH FIRST 5 ROWS WITH TIES;
-- CTE
-- updated for the cte we could use ranks method in order to get the correct result
-- in this case we have DENSE_RANK and have a top for each group 1 is 12 movies 2 is 11 movies and so on.
WITH actor_movie_counts AS (
    SELECT a.actor_id,
        a.first_name,
        a.last_name,
        COUNT(DISTINCT f.film_id) AS number_of_movies
    FROM public.actor AS a
        INNER JOIN public.film_actor AS fa ON fa.actor_id = a.actor_id
        INNER JOIN public.film AS f ON f.film_id = fa.film_id
    WHERE f.release_year >= 2015
    GROUP BY a.actor_id,
        a.first_name,
        a.last_name
),
ranked_actors AS (
    SELECT first_name,
        last_name,
        number_of_movies,
        DENSE_RANK() OVER (
            ORDER BY number_of_movies DESC
        ) AS movie_rank
    FROM actor_movie_counts
)
SELECT first_name,
    last_name,
    number_of_movies
FROM ranked_actors
WHERE movie_rank <= 5
ORDER BY number_of_movies DESC,
    last_name,
    first_name;
-- Subquery
SELECT first_name,
    last_name,
    number_of_movies
FROM (
        SELECT a.actor_id,
            a.first_name,
            a.last_name,
            COUNT(DISTINCT f.film_id) AS number_of_movies
        FROM public.actor AS a
            INNER JOIN public.film_actor AS fa ON fa.actor_id = a.actor_id
            INNER JOIN public.film AS f ON f.film_id = fa.film_id
        WHERE f.release_year >= 2015
        GROUP BY a.actor_id,
            a.first_name,
            a.last_name
    ) AS actor_movie_counts
ORDER BY number_of_movies DESC
FETCH FIRST 5 ROWS WITH TIES;
-- task 4
/*
 Show the number of Drama, Travel and Documentary films per release year.
 LEFT JOIN keeps films even if a category relationship is missing. In that case it prevents the missing year.
 COUNT(DISTINCT ...) prevents the same film from being counted twice.
 
 The same idea of ussing direct JOIN method remains here. 
 */
SELECT f.release_year,
    -- in order to have columns in task design we need to create new collumns with case statement
    COUNT(
        DISTINCT CASE
            WHEN c.name = 'Drama' THEN f.film_id
        END
    ) AS number_of_drama_movies,
    COUNT(
        DISTINCT CASE
            WHEN c.name = 'Travel' THEN f.film_id
        END
    ) AS number_of_travel_movies,
    COUNT(
        DISTINCT CASE
            WHEN c.name = 'Documentary' THEN f.film_id
        END
    ) AS number_of_documentary_movies
FROM public.film AS f
    LEFT JOIN public.film_category AS fc ON fc.film_id = f.film_id
    LEFT JOIN public.category AS c ON c.category_id = fc.category_id
GROUP BY f.release_year
ORDER BY f.release_year DESC NULLS LAST;
-- CTE
WITH film_categories AS (
    SELECT f.film_id,
        f.release_year,
        c.name AS category_name
    FROM public.film AS f
        LEFT JOIN public.film_category AS fc ON fc.film_id = f.film_id
        LEFT JOIN public.category AS c ON c.category_id = fc.category_id
)
SELECT release_year,
    COUNT(
        DISTINCT CASE
            WHEN category_name = 'Drama' THEN film_id
        END
    ) AS number_of_drama_movies,
    COUNT(
        DISTINCT CASE
            WHEN category_name = 'Travel' THEN film_id
        END
    ) AS number_of_travel_movies,
    COUNT(
        DISTINCT CASE
            WHEN category_name = 'Documentary' THEN film_id
        END
    ) AS number_of_documentary_movies
FROM film_categories
GROUP BY release_year
ORDER BY release_year DESC;
--Subquery
SELECT release_year,
    COUNT(
        DISTINCT CASE
            WHEN category_name = 'Drama' THEN film_id
        END
    ) AS number_of_drama_movies,
    COUNT(
        DISTINCT CASE
            WHEN category_name = 'Travel' THEN film_id
        END
    ) AS number_of_travel_movies,
    COUNT(
        DISTINCT CASE
            WHEN category_name = 'Documentary' THEN film_id
        END
    ) AS number_of_documentary_movies
FROM (
        SELECT f.film_id,
            f.release_year,
            c.name AS category_name
        FROM public.film AS f
            LEFT JOIN public.film_category AS fc ON fc.film_id = f.film_id
            LEFT JOIN public.category AS c ON c.category_id = fc.category_id
    ) AS film_categories
GROUP BY release_year
ORDER BY release_year DESC;